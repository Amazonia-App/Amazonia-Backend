{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Core/SqliteTestServers/app.db"
  },
  "Discord": {
    "ClientId": "YOUR_DISCORD_CLIENT_ID",
    "ClientSecret": "YOUR_DISCORD_CLIENT_SECRET"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "FrontendUrl": "http://localhost:3000",
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:7087"
      }
    },
    "Certificates": {
      "Default": {
        "Path": "certs/localhost.pem",
        "KeyPath": "certs/localhost-key.pem"
      }
    }
  }
}

